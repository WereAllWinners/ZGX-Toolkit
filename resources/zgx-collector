#!/usr/bin/env python3
"""
zgx-collector v1.1 — cross-architecture Linux manageability collector for ZGX Toolkit.

Supports:
  - NVIDIA GPUs (nvidia-smi) — DGX Spark GB10, RTX, A/H-series
  - AMD GPUs (rocm-smi / sysfs) — Strix Halo, Instinct, discrete Radeon
  - x86_64 and aarch64; single and multi-GPU systems
  - Unified memory detection for AMD APUs (Strix Halo / Ryzen AI Max)
  - CPU-only hosts (no GPU tooling required)

Output: JSON envelope  {"tool":..., "timestamp":..., "status":"ok", "data":{...}}
"""
import json, subprocess, sys, os, shutil, glob
from datetime import datetime, timezone

VERSION = "1.3.0"

# Non-interactive SSH sessions often have a stripped PATH that omits the directories
# where NVIDIA/AMD tools live.  Prepend the common install prefixes so that
# shutil.which() and subprocess can always locate nvidia-smi, rocm-smi, etc.
for _p in ('/usr/local/cuda/bin', '/usr/local/bin', '/usr/local/sbin',
           '/usr/bin', '/usr/sbin', '/bin', '/sbin', '/opt/rocm/bin'):
    if _p not in os.environ.get('PATH', ''):
        os.environ['PATH'] = _p + ':' + os.environ.get('PATH', '')

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def now_iso():
    return datetime.now(timezone.utc).isoformat()

def run(cmd, timeout=10):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout.strip(), r.returncode == 0
    except Exception:
        return "", False

def read_file(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except Exception:
        return default

def read_dmi(field, default=""):
    """Read a DMI field directly from sysfs (root-less)."""
    return read_file(f"/sys/class/dmi/id/{field}", default)

def device_id_block():
    """Root-less device identity block for the JSON envelope: serial, uuid,
    hostname. Serial/uuid are root-only readable on many distros and will be
    empty in that case rather than escalating via sudo."""
    hostname, _ = run(["hostname", "-f"])
    if not hostname:
        hostname, _ = run(["hostname"])
    return {
        "serial": read_dmi("product_serial"),
        "uuid": read_dmi("product_uuid"),
        "hostname": hostname,
    }

def envelope(tool, data, status="ok", errors=None):
    errors = errors or []
    summary_map = {
        "ok": f"{tool} collected successfully",
        "partial": f"{tool} collected with {len(errors)} error(s)",
        "error": f"{tool} failed to collect data",
    }
    return {
        # Canonical envelope fields (matches DGX_spark_management/bin/_envelope.py)
        "tool_name": tool,
        "tool_version": VERSION,
        "timestamp_utc": now_iso(),
        "device_id": device_id_block(),
        "status": status,
        "summary": summary_map.get(status, f"{tool}: {status}"),
        "data": data,
        "artifacts": [],
        "errors": errors,
        # TypeScript ManageabilityEnvelope aliases (unchanged from v1.x)
        "tool": tool,
        "timestamp": now_iso(),
    }

def safe_float(v, default=None):
    try:
        return float(str(v).strip().split()[0].rstrip("CcWw%°"))
    except Exception:
        return default

# ---------------------------------------------------------------------------
# GPU vendor detection
# ---------------------------------------------------------------------------

def detect_gpu_vendor():
    """Returns 'nvidia', 'amd', 'intel', or 'none'."""
    if shutil.which("nvidia-smi"):
        out, ok = run(["nvidia-smi", "-L"], timeout=5)
        if ok and out:
            return "nvidia"
    if shutil.which("rocm-smi"):
        _, ok = run(["rocm-smi", "--version"], timeout=5)
        if ok:
            return "amd"
    # Sysfs fallback for AMD without ROCm
    for vp in glob.glob("/sys/class/drm/card*/device/vendor"):
        if read_file(vp) == "0x1002":
            return "amd"
    # Sysfs fallback for Intel iGPU/dGPU  # best-effort: not yet validated on Intel hardware
    for vp in glob.glob("/sys/class/drm/card*/device/vendor"):
        if read_file(vp) == "0x8086":
            return "intel"
    return "none"

# ---------------------------------------------------------------------------
# NVIDIA GPU collection
# ---------------------------------------------------------------------------

def get_nvidia_gpus():
    fields = "index,name,temperature.gpu,power.draw,memory.total,memory.used"
    out, ok = run(["nvidia-smi", f"--query-gpu={fields}", "--format=csv,noheader,nounits"])
    if not ok or not out:
        return []
    gpus = []
    for line in out.splitlines():
        p = [x.strip() for x in line.split(",")]
        if len(p) < 6:
            continue
        def f(v): return safe_float(v) if v not in ("[N/A]", "N/A", "") else None
        gpus.append({
            "index":           int(p[0]) if p[0].isdigit() else len(gpus),
            "name":            p[1],
            "vendor":          "nvidia",
            "temp_c":          f(p[2]),
            "power_w":         f(p[3]),
            "memory_total_mb": f(p[4]),
            "memory_used_mb":  f(p[5]),
            "unified_memory":  False,
        })
    return gpus

# ---------------------------------------------------------------------------
# AMD GPU collection
# ---------------------------------------------------------------------------

def _system_ram_mb():
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    return int(line.split()[1]) / 1024
    except Exception:
        pass
    return 0

def _is_unified(vram_mb):
    """True when VRAM ≈ system RAM (APU / Strix Halo unified memory)."""
    sys_mb = _system_ram_mb()
    return sys_mb > 0 and abs(vram_mb - sys_mb) / sys_mb < 0.15

def get_amd_gpus_rocm():
    """Parse rocm-smi --showallinfo --json. Returns list or None on failure."""
    out, ok = run(["rocm-smi", "--showallinfo", "--json"], timeout=15)
    if not ok or not out:
        return None
    try:
        data = json.loads(out)
    except Exception:
        return None

    gpus = []
    for key in sorted(data.keys()):
        if not key.startswith("card"):
            continue
        val = data[key]

        name = (val.get("Card Series") or val.get("Card model") or
                val.get("Card SKU") or "AMD GPU")

        # Temperature — prefer junction, then edge
        temp = None
        for tk in ["Temperature (Sensor junction) (C)",
                   "Temperature (Sensor edge) (C)",
                   "Temperature (Sensor memory) (C)"]:
            if val.get(tk) not in (None, "N/A", ""):
                temp = safe_float(val[tk]); break

        # Power
        power = None
        for pk in ["Average Graphics Package Power (W)",
                   "Current Socket Graphics Package Power (W)"]:
            if val.get(pk) not in (None, "N/A", ""):
                power = safe_float(val[pk]); break

        # VRAM
        vram_total_mb = None
        vram_used_mb  = None
        raw_total = val.get("VRAM Total Memory (B)")
        raw_used  = val.get("VRAM Total Used Memory (B)")
        try:
            if raw_total: vram_total_mb = int(raw_total) / (1024 ** 2)
        except Exception: pass
        try:
            if raw_used: vram_used_mb = int(raw_used) / (1024 ** 2)
        except Exception: pass

        unified = _is_unified(vram_total_mb) if vram_total_mb else False

        gpus.append({
            "index":           len(gpus),
            "name":            name,
            "vendor":          "amd",
            "temp_c":          temp,
            "power_w":         power,
            "memory_total_mb": vram_total_mb,
            "memory_used_mb":  vram_used_mb,
            "unified_memory":  unified,
        })
    return gpus if gpus else None

def get_amd_gpu_sysfs(card):
    """Sysfs fallback for one AMD drm card entry (e.g. 'card0')."""
    base = f"/sys/class/drm/{card}/device"

    # Best-effort name from rocm-smi single-card query
    name = "AMD GPU"
    if shutil.which("rocm-smi"):
        out, ok = run(["rocm-smi", "--showproductname", "--json"], timeout=5)
        if ok and out:
            try:
                d = json.loads(out)
                for v in d.values():
                    if isinstance(v, dict):
                        n = v.get("Card Series") or v.get("Card model") or ""
                        if n: name = n; break
            except Exception: pass

    # Temperature from hwmon
    temp = None
    for hwmon in glob.glob(f"{base}/hwmon/hwmon*"):
        for lp in glob.glob(f"{hwmon}/temp*_label"):
            lbl = read_file(lp).lower()
            if any(x in lbl for x in ("junction", "edge", "temp1")):
                raw = read_file(lp.replace("_label", "_input"))
                if raw:
                    try: temp = int(raw) / 1000.0; break
                    except: pass
        if temp is not None: break

    # Power from hwmon (µW → W)
    power = None
    for hwmon in glob.glob(f"{base}/hwmon/hwmon*"):
        raw = read_file(f"{hwmon}/power1_average")
        if raw:
            try: power = int(raw) / 1_000_000.0; break
            except: pass

    # VRAM from sysfs
    vram_total_mb = None
    vram_used_mb  = None
    raw_t = read_file(f"{base}/mem_info_vram_total")
    raw_u = read_file(f"{base}/mem_info_vram_used")
    if raw_t.isdigit(): vram_total_mb = int(raw_t) / (1024 ** 2)
    if raw_u.isdigit(): vram_used_mb  = int(raw_u) / (1024 ** 2)

    unified = _is_unified(vram_total_mb) if vram_total_mb else False

    idx_str = card.replace("card", "")
    return {
        "index":           int(idx_str) if idx_str.isdigit() else 0,
        "name":            name,
        "vendor":          "amd",
        "temp_c":          temp,
        "power_w":         power,
        "memory_total_mb": vram_total_mb,
        "memory_used_mb":  vram_used_mb,
        "unified_memory":  unified,
    }

def get_amd_gpus():
    # Enumerate AMD DRM cards
    cards = sorted([
        e for e in os.listdir("/sys/class/drm")
        if e.startswith("card") and "-" not in e and
           read_file(f"/sys/class/drm/{e}/device/vendor") == "0x1002"
    ]) if os.path.isdir("/sys/class/drm") else []

    if not cards:
        return []

    # Try rocm-smi first for richer data
    if shutil.which("rocm-smi"):
        result = get_amd_gpus_rocm()
        if result is not None:
            return result

    # Sysfs fallback
    return [get_amd_gpu_sysfs(c) for c in cards]

# ---------------------------------------------------------------------------
# GPU health signals (shared by cmd_health)
# ---------------------------------------------------------------------------

def gpu_health_signals(vendor):
    """Returns (signals_list, gpus_list)."""
    signals, gpus = [], []

    if vendor == "nvidia":
        all_gpus = get_nvidia_gpus()
        multi = len(all_gpus) > 1
        for gpu in all_gpus:
            tag = f"gpu{gpu['index']}_" if multi else "gpu_"
            t = gpu.get("temp_c")
            if t is not None:
                st = "critical" if t >= 85 else "degraded" if t >= 80 else "ok"
                signals.append({"name": f"{tag}temp",  "status": st,  "value": t,                   "unit": "C"})
            p = gpu.get("power_w")
            if p is not None:
                signals.append({"name": f"{tag}power", "status": "ok", "value": round(p, 1),        "unit": "W"})
            gpus.append(gpu)

    elif vendor == "amd":
        all_gpus = get_amd_gpus()
        multi = len(all_gpus) > 1
        for gpu in all_gpus:
            tag = f"gpu{gpu['index']}_" if multi else "gpu_"
            t = gpu.get("temp_c")
            if t is not None:
                # AMD junction temps run hotter by design
                st = "critical" if t >= 95 else "degraded" if t >= 85 else "ok"
                signals.append({"name": f"{tag}temp",  "status": st,  "value": round(t, 1),         "unit": "C"})
            p = gpu.get("power_w")
            if p is not None:
                signals.append({"name": f"{tag}power", "status": "ok", "value": round(p, 1),        "unit": "W"})
            gpus.append(gpu)

    return signals, gpus

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

def cmd_device_identity():
    hostname, _ = run(["hostname", "-f"])
    if not hostname:
        hostname, _ = run(["hostname"])
    return envelope("device-identity", {
        "hostname":     hostname,
        "product_name": read_file("/sys/class/dmi/id/product_name"),
        "manufacturer": read_file("/sys/class/dmi/id/sys_vendor"),
        "board_name":   read_file("/sys/class/dmi/id/board_name"),
        "bios_version": read_file("/sys/class/dmi/id/bios_version"),
        "bios_date":    read_file("/sys/class/dmi/id/bios_date"),
    })

def cmd_os_build():
    props = {}
    try:
        with open("/etc/os-release") as f:
            for line in f:
                k, _, v = line.strip().partition("=")
                props[k] = v.strip('"')
    except Exception: pass
    kernel,       _ = run(["uname", "-r"])
    kernel_build, _ = run(["uname", "-v"])
    arch,         _ = run(["uname", "-m"])
    return envelope("os-build", {
        "os_name":      props.get("NAME", ""),
        "os_version":   props.get("VERSION_ID", ""),
        "os_pretty":    props.get("PRETTY_NAME", ""),
        "kernel":       kernel,
        "kernel_build": kernel_build,
        "architecture": arch,
    })

def cmd_hardware_config():
    # CPU via lscpu
    cpu_info = {}
    out, ok = run(["lscpu", "--json"])
    if ok:
        try:
            entries = {e["field"].rstrip(":"): e["data"]
                       for e in json.loads(out).get("lscpu", [])}
            cpu_info = {
                "model_names":    [entries.get("Model name", "")],
                "cores":          int(entries.get("CPU(s)", 0) or 0),
                "threads_per_core": int(entries.get("Thread(s) per core", 1) or 1),
                "architecture":   entries.get("Architecture", ""),
            }
        except Exception: pass

    # RAM
    mem_bytes = 0
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    mem_bytes = int(line.split()[1]) * 1024; break
    except Exception: pass

    # GPUs
    vendor = detect_gpu_vendor()
    gpus   = get_nvidia_gpus() if vendor == "nvidia" else \
             get_amd_gpus()    if vendor == "amd"    else []

    # Storage
    storage = []
    out, ok = run(["lsblk", "-J", "-o", "NAME,SIZE,TYPE,MOUNTPOINT"])
    if ok:
        try:
            for dev in json.loads(out).get("blockdevices", []):
                if dev.get("type") == "disk":
                    storage.append({"name": dev["name"], "size": dev.get("size", "")})
        except Exception: pass

    # NICs
    nics = []
    out, ok = run(["ip", "-j", "link"])
    if ok:
        try:
            for link in json.loads(out):
                if link.get("link_type") == "ether":
                    nics.append({"name": link["ifname"], "mac": link.get("address", "")})
        except Exception: pass

    return envelope("hardware-config", {
        "cpu":                cpu_info,
        "gpu_vendor":         vendor,
        "gpus":               gpus,
        "total_memory_bytes": mem_bytes,
        "storage":            storage,
        "nics":               nics,
    })

def cmd_firmware():
    return envelope("firmware", {
        "uefi_version": read_file("/sys/class/dmi/id/bios_version"),
        "bios_date":    read_file("/sys/class/dmi/id/bios_date"),
        "bmc_version":  read_file("/sys/class/dmi/id/chassis_version") or "N/A",
    })

def cmd_drivers():
    vendor  = detect_gpu_vendor()
    entries = []
    gpu_driver_version = None

    # Fetch all installed packages once; glob patterns don't expand in subprocess
    # list args, so filter in Python instead.
    all_pkgs = {}
    pkg_out, pkg_ok = run(["dpkg-query", "-W", "-f=${Package} ${Version}\n"], timeout=30)
    if pkg_ok:
        for line in pkg_out.splitlines():
            p = line.split(None, 1)
            if len(p) == 2:
                all_pkgs[p[0]] = p[1]

    # Always probe both NVIDIA and AMD paths — vendor detection can miss GPUs
    # that have the hardware present but no management tool in PATH.

    # ── NVIDIA ──────────────────────────────────────────────────────────────
    nvidia_ver, nvidia_ok = run(["nvidia-smi", "--query-gpu=driver_version",
                                 "--format=csv,noheader"])
    if nvidia_ok and nvidia_ver:
        gpu_driver_version = nvidia_ver.splitlines()[0].strip()
        entries.append({"name": "nvidia-driver", "version": gpu_driver_version})
    for name, version in all_pkgs.items():
        if any(kw in name.lower() for kw in ("nvidia", "cuda", "libnvidia")):
            entries.append({"name": name, "version": version})

    # ── AMD ─────────────────────────────────────────────────────────────────
    amd_ver, amd_ok = run(["modinfo", "amdgpu", "-F", "version"])
    if amd_ok and amd_ver:
        amd_ver = amd_ver.strip()
        if not gpu_driver_version:
            gpu_driver_version = amd_ver
        entries.append({"name": "amdgpu", "version": amd_ver})
    for name, version in all_pkgs.items():
        if any(kw in name.lower() for kw in ("amdgpu", "rocm", "hip", "opencl-amd", "rocr")):
            entries.append({"name": name, "version": version})

    # De-duplicate (nvidia-driver may appear both from nvidia-smi and dpkg)
    seen = set()
    deduped = []
    for e in entries:
        key = (e["name"], e["version"])
        if key not in seen:
            seen.add(key)
            deduped.append(e)

    return envelope("drivers", {
        "gpu_vendor":        vendor,
        "gpu_driver_version": gpu_driver_version,
        "entries":           deduped,
    })

def cmd_software():
    count = 0
    out, ok = run(["dpkg-query", "-W", "-f=${Status}\n"], timeout=30)
    if ok:
        count = sum(1 for line in out.splitlines() if "installed" in line)
    return envelope("software", {"package_count": count})

def cmd_health():
    vendor          = detect_gpu_vendor()
    signals         = []
    gpu_signals, gpus = gpu_health_signals(vendor)

    # CPU temperature via lm-sensors (best-effort)
    if shutil.which("sensors"):
        out, ok = run(["sensors", "-j"], timeout=5)
        if ok and out:
            try:
                max_t = max(
                    (v for chip in json.loads(out).values()
                     for sensor in chip.values() if isinstance(sensor, dict)
                     for k, v in sensor.items()
                     if "input" in k and isinstance(v, (int, float))),
                    default=None
                )
                if max_t is not None:
                    st = "critical" if max_t >= 95 else "degraded" if max_t >= 85 else "ok"
                    signals.append({"name": "cpu_temp", "status": st,
                                    "value": round(max_t, 1), "unit": "C"})
            except Exception: pass

    # Memory pressure
    try:
        mem = {}
        with open("/proc/meminfo") as f:
            for line in f:
                k, _, v = line.partition(":")
                mem[k.strip()] = int(v.strip().split()[0]) * 1024
        total, avail = mem.get("MemTotal", 0), mem.get("MemAvailable", 0)
        if total:
            pct = (total - avail) / total * 100
            st  = "critical" if pct >= 95 else "degraded" if pct >= 85 else "ok"
            signals.append({"name": "memory_pressure", "status": st,
                            "value": round(pct, 1), "unit": "%"})
    except Exception: pass

    # Root disk usage
    out, ok = run(["df", "-k", "/"])
    if ok:
        try:
            parts = out.splitlines()[1].split()
            pct   = float(parts[4].rstrip("%"))
            st    = "critical" if pct >= 95 else "degraded" if pct >= 85 else "ok"
            signals.append({"name": "disk_usage_root", "status": st,
                            "value": round(pct, 1), "unit": "%"})
        except Exception: pass

    signals.extend(gpu_signals)

    statuses = [s["status"] for s in signals]
    if "critical" in statuses:   overall = "critical"
    elif "degraded" in statuses: overall = "degraded"
    elif statuses:               overall = "healthy"
    else:                        overall = "unknown"

    return envelope("health", {
        "overall_status": overall,
        "gpu_vendor":     vendor,
        "signals":        signals,
        "gpus":           gpus,
    })

# Package name prefixes that identify HP/HPE software packages.
_HP_PKG_PREFIXES = ("hp-", "hpe-", "hplib", "hpsmh", "hpssacli", "hponcfg", "hpwmi")
# Keywords that distinguish HP firmware/BIOS packages from driver/tool packages.
_HP_FW_KEYWORDS  = ("firmware", "bios", "flash", "uefi", "microcode")

def _hp_apt_updates(upgradable):
    """Return HP-prefixed entries from the already-fetched upgradable list."""
    hp = []
    for e in upgradable:
        name = e["name"].lower()
        if any(name.startswith(p) for p in _HP_PKG_PREFIXES):
            is_fw = any(kw in name for kw in _HP_FW_KEYWORDS)
            hp.append({
                "name":    e["name"],
                "version": e["version"],
                "type":    "hp_firmware" if is_fw else "hp_driver",
            })
    return hp

def _hp_flash_check():
    """Detect the HP BIOS flash utility (hpflash / hp-flash) and report its version."""
    for tool in ("hpflash", "hp-flash"):
        exe = shutil.which(tool)
        if not exe:
            continue
        ver_out, ver_ok = run([exe, "--version"], timeout=5)
        if not ver_ok or not ver_out:
            ver_out, ver_ok = run([exe, "-v"], timeout=5)
        version = ver_out.strip().splitlines()[0] if (ver_ok and ver_out) else "present"
        return [{
            "name":    tool,
            "version": version,
            "type":    "hp_firmware",
            "source":  "hp_flash_tool",
        }]
    return []

def _hp_repo_configured():
    """Return True if the HP Software Delivery Repository is in apt sources."""
    candidates = (glob.glob("/etc/apt/sources.list.d/*.list") +
                  glob.glob("/etc/apt/sources.list.d/*.sources") +
                  ["/etc/apt/sources.list"])
    for f in candidates:
        try:
            with open(f) as fh:
                content = fh.read()
                if "hp.com" in content or "hpe.com" in content:
                    return True
        except OSError:
            pass
    return False

def cmd_updates():
    # ── fetch upgradable packages once ────────────────────────────────────────
    up_out, up_ok = run(["apt", "list", "--upgradable"], timeout=60)
    upgradable = []
    if up_ok:
        for line in up_out.splitlines():
            if "/" not in line or line.startswith("Listing"): continue
            parts = line.split()
            upgradable.append({"name": parts[0].split("/")[0],
                                "version": parts[1] if len(parts) > 1 else ""})

    # ── 1. HP-specific drivers and firmware (checked before generic fwupdmgr) ─
    hp_updates   = _hp_apt_updates(upgradable) + _hp_flash_check()
    hp_names     = {e["name"] for e in hp_updates}

    # ── 2. general apt packages (HP packages already captured above) ──────────
    apt_updates = [
        {"name": e["name"], "version": e["version"], "type": "apt"}
        for e in upgradable
        if e["name"] not in hp_names
    ]

    # ── 3. firmware via fwupdmgr ──────────────────────────────────────────────
    # fwupdmgr exits 2 when nothing to update — always try to parse output.
    fw_updates = []
    if shutil.which("fwupdmgr"):
        fw_out, _ = run(["fwupdmgr", "get-updates", "--json"], timeout=60)
        if fw_out.strip():
            try:
                fw_data = json.loads(fw_out)
                for dev in fw_data.get("Devices", []):
                    releases = dev.get("Releases", [])
                    if releases:
                        fw_updates.append({
                            "name":    dev.get("Name", "Unknown firmware"),
                            "version": releases[0].get("Version", ""),
                            "type":    "firmware",
                        })
            except Exception:
                pass

    all_updates = hp_updates + apt_updates + fw_updates
    return envelope("updates", {
        "status":           "updates_available" if all_updates else "up_to_date",
        "pending_updates":  all_updates,
        "hp_count":         len(hp_updates),
        "apt_count":        len(apt_updates),
        "firmware_count":   len(fw_updates),
        "hp_repo_present":  _hp_repo_configured(),
    })

# ---------------------------------------------------------------------------
# Platform profile
# ---------------------------------------------------------------------------

def cmd_platform_profile():
    errors = []

    # Manufacturer / product / HP detection
    manufacturer = read_file("/sys/class/dmi/id/sys_vendor")
    product_name = read_file("/sys/class/dmi/id/product_name")
    is_hp_device = manufacturer.lower().startswith(("hp", "hewlett"))

    # Architecture
    arch_raw, _ = run(["uname", "-m"])
    arch = "arm64" if arch_raw == "aarch64" else (arch_raw or "unknown")

    # CPU vendor / model / cores
    cpu_vendor = "unknown"
    cpu_model = ""
    cpu_cores_logical = 0
    try:
        with open("/proc/cpuinfo") as f:
            cpuinfo = f.read()
        for line in cpuinfo.splitlines():
            if ":" not in line:
                continue
            key, _, val = line.partition(":")
            key = key.strip().lower()
            val = val.strip()
            if key == "vendor_id":
                if val == "GenuineIntel":
                    cpu_vendor = "intel"
                elif val == "AuthenticAMD":
                    cpu_vendor = "amd"
            elif key == "cpu implementer" and cpu_vendor == "unknown":
                # 0x41 = ARM Ltd. (used by Grace GB10 Cortex cores, Neoverse,
                # and all other ARM-licensed designs — not sufficient alone).
                # nvidia-grace is resolved after GPU vendor detection below.
                cpu_vendor = "arm"
            elif key == "model name" and not cpu_model:
                cpu_model = val
        # ARM /proc/cpuinfo has no "model name"; fall back to lscpu
        if not cpu_model:
            lscpu_out, _ = run(["lscpu", "--json"])
            if lscpu_out:
                try:
                    lscpu_data = json.loads(lscpu_out)
                    models = [e["data"] for e in lscpu_data.get("lscpu", [])
                              if e.get("field", "").startswith("Model name")]
                    seen = []
                    for m in models:
                        if m not in seen:
                            seen.append(m)
                    cpu_model = " / ".join(seen)
                except Exception:
                    pass
        # Count logical processors
        cpu_cores_logical = sum(1 for l in cpuinfo.splitlines()
                                if l.startswith("processor") and ":" in l)
        if cpu_cores_logical == 0:
            nproc_out, _ = run(["nproc"])
            try:
                cpu_cores_logical = int(nproc_out)
            except Exception:
                cpu_cores_logical = 0
    except Exception as e:
        errors.append({"code": "cpu_detection_failed", "message": str(e)})

    # OS
    os_id = os_id_like = os_version_id = os_pretty_name = ""
    try:
        with open("/etc/os-release") as f:
            for line in f:
                k, _, v = line.strip().partition("=")
                v = v.strip('"')
                if k == "ID":           os_id = v
                elif k == "ID_LIKE":    os_id_like = v
                elif k == "VERSION_ID": os_version_id = v
                elif k == "PRETTY_NAME": os_pretty_name = v
    except Exception as e:
        errors.append({"code": "os_release_failed", "message": str(e)})

    combined = (os_id + " " + os_id_like).lower()
    if any(x in combined for x in ("debian", "ubuntu")):
        os_family = "debian"
    elif any(x in combined for x in ("rhel", "fedora", "centos")):
        os_family = "rhel"
    elif any(x in combined for x in ("suse", "opensuse")):
        os_family = "suse"
    else:
        os_family = "unknown"

    # DGX OS
    is_dgx_os = os.path.exists("/etc/dgx-release")
    dgx_release = ""
    if is_dgx_os:
        try:
            with open("/etc/dgx-release") as f:
                for line in f:
                    k, _, v = line.strip().partition("=")
                    if k.strip() in ("DGX_SWBUILD_VERSION", "DGX_OS_VERSION"):
                        dgx_release = v.strip().strip('"')
                        break
        except Exception:
            pass

    # Package manager
    if shutil.which("apt-get"):
        package_manager = "apt"
    elif shutil.which("dnf"):
        package_manager = "dnf"
    elif shutil.which("zypper"):
        package_manager = "zypper"
    else:
        package_manager = ""

    # Kernel release / flavor
    kernel_release, _ = run(["uname", "-r"])
    kernel_flavor = kernel_release.rsplit("-", 1)[-1] if "-" in kernel_release else ""

    # GPU vendor (reuses detect_gpu_vendor which now handles nvidia/amd/intel/none)
    gpu_vendor = detect_gpu_vendor()

    # GPU compute stack / version
    gpu_compute_stack = "none"
    gpu_compute_stack_version = ""
    if gpu_vendor == "nvidia":
        gpu_compute_stack = "cuda"
        smi_out, _ = run(["nvidia-smi"], timeout=10)
        for line in smi_out.splitlines():
            if "CUDA Version" in line:
                try:
                    gpu_compute_stack_version = line.split("CUDA Version:")[-1].strip().split()[0]
                except Exception:
                    pass
                break
        if not gpu_compute_stack_version:
            ver_txt = read_file("/usr/local/cuda/version.txt")
            if ver_txt:
                gpu_compute_stack_version = ver_txt.split()[-1]
    elif gpu_vendor == "amd":
        if shutil.which("rocm-smi"):
            gpu_compute_stack = "rocm"
            ver = read_file("/opt/rocm/.info/version").strip()
            if ver:
                gpu_compute_stack_version = ver.split()[0]
    elif gpu_vendor == "intel":  # best-effort: not yet validated on Intel hardware
        if shutil.which("sycl-ls") or os.path.isdir("/opt/intel/oneapi"):
            gpu_compute_stack = "oneapi"

    # GPU memory model
    gpu_memory_model = "none"
    if gpu_vendor == "nvidia":
        try:
            nvidia_gpus = get_nvidia_gpus()
            # GB10: nvidia-smi reports N/A → memory_total_mb is None → unified memory
            if any(g.get("memory_total_mb") is None for g in nvidia_gpus):
                gpu_memory_model = "unified"
            elif nvidia_gpus:
                gpu_memory_model = "discrete"
        except Exception:
            gpu_memory_model = "discrete"
    elif gpu_vendor == "amd":  # best-effort: not yet validated on AMD hardware
        try:
            amd_gpus = get_amd_gpus()
            if any(g.get("unified_memory") for g in amd_gpus):
                gpu_memory_model = "unified"
            elif amd_gpus and any(g.get("memory_total_mb") for g in amd_gpus):
                gpu_memory_model = "discrete"
            else:
                gpu_memory_model = "integrated"
        except Exception:
            gpu_memory_model = "integrated"
    elif gpu_vendor == "intel":  # best-effort: not yet validated on Intel hardware
        gpu_memory_model = "integrated"

    # GPU driver branch
    gpu_driver_branch = ""
    if gpu_vendor == "nvidia":
        drv_out, ok = run(["nvidia-smi", "--query-gpu=driver_version",
                           "--format=csv,noheader"])
        if ok and drv_out.strip():
            try:
                gpu_driver_branch = drv_out.strip().split(".")[0]
            except Exception:
                pass
    elif gpu_vendor == "amd":
        amdgpu_ver, ok = run(["modinfo", "amdgpu", "-F", "version"])
        if ok and amdgpu_ver.strip():
            gpu_driver_branch = amdgpu_ver.strip().split()[0]

    # Held packages
    held_packages = []
    try:
        if package_manager == "apt":
            held_out, _ = run(["apt-mark", "showhold"])
            held_packages = [p for p in held_out.splitlines() if p.strip()]
        elif package_manager == "dnf":
            held_out, _ = run(["dnf", "versionlock", "list"])
            for line in held_out.splitlines():
                line = line.strip()
                if not line or line.startswith(("#", "Last metadata")):
                    continue
                parts = line.split()
                if parts:
                    held_packages.append(parts[0])
        elif package_manager == "zypper":
            held_out, _ = run(["zypper", "locks"])
            for line in held_out.splitlines():
                parts = [p.strip() for p in line.split("|")]
                if len(parts) >= 4 and parts[0].isdigit():
                    if parts[3]:
                        held_packages.append(parts[3])
    except Exception as e:
        errors.append({"code": "held_packages_failed", "message": str(e)})

    # Held kernel packages
    kernel_prefixes = ("linux-image", "linux-headers", "kernel-", "kernel-default")
    held_kernel_packages = [p for p in held_packages
                             if any(p.startswith(pfx) for pfx in kernel_prefixes)]

    # Vendor controller
    vendor_controller_spark_updatectl = bool(
        shutil.which("spark_updatectl.py") or
        os.path.exists("/usr/local/lib/DGX_spark_management/bin/spark_updatectl.py")
    )

    # nvidia-grace: Grace SoC products use ARM-licensed cores (Cortex-X925/A725
    # on GB10, Neoverse V2 on DGX Grace Hopper, Cortex-A78AE on Jetson Orin).
    # All report implementer 0x41 (ARM Ltd.) — no single part code covers all.
    # Reliable discriminant: arm64 + NVIDIA GPU = Grace-family system.
    if arch == "arm64" and gpu_vendor == "nvidia":
        cpu_vendor = "nvidia-grace"

    data = {
        "manufacturer":                      manufacturer,
        "product_name":                      product_name,
        "is_hp_device":                      is_hp_device,
        "arch":                              arch,
        "cpu_vendor":                        cpu_vendor,
        "cpu_model":                         cpu_model,
        "cpu_cores_logical":                 cpu_cores_logical,
        "os_id":                             os_id,
        "os_id_like":                        os_id_like,
        "os_family":                         os_family,
        "os_version_id":                     os_version_id,
        "os_pretty_name":                    os_pretty_name,
        "is_dgx_os":                         is_dgx_os,
        "dgx_release":                       dgx_release,
        "package_manager":                   package_manager,
        "kernel_release":                    kernel_release,
        "kernel_flavor":                     kernel_flavor,
        "gpu_vendor":                        gpu_vendor,
        "gpu_compute_stack":                 gpu_compute_stack,
        "gpu_compute_stack_version":         gpu_compute_stack_version,
        "gpu_memory_model":                  gpu_memory_model,
        "gpu_driver_branch":                 gpu_driver_branch,
        "held_packages":                     held_packages,
        "held_kernel_packages":              held_kernel_packages,
        "vendor_controller_spark_updatectl": vendor_controller_spark_updatectl,
    }
    result = envelope("platform-profile", data)
    if errors:
        result["status"] = "partial"
        result["errors"] = errors
    return result

# ---------------------------------------------------------------------------
# Update availability (read-only, package-manager-first)
# ---------------------------------------------------------------------------

def _ua_parse_apt():
    """Return (updates, error_str_or_None) using apt list --upgradable."""
    try:
        r = subprocess.run(
            ["apt", "list", "--upgradable"],
            capture_output=True, text=True, timeout=60,
            env={**os.environ, "LANG": "C", "LC_ALL": "C"},
        )
        out = r.stdout
    except Exception as exc:
        return [], str(exc)
    updates = []
    for line in out.splitlines():
        if line.startswith("Listing") or "/" not in line:
            continue
        try:
            parts = line.split()
            package = parts[0].split("/")[0]
            available_version = parts[1] if len(parts) > 1 else ""
            current_version = ""
            if "[upgradable from:" in line:
                current_version = line.split("[upgradable from:")[-1].rstrip("]").strip()
            updates.append({
                "package": package,
                "current_version": current_version,
                "available_version": available_version,
            })
        except Exception:
            continue
    return updates, None


def _ua_parse_dnf():
    """Return (updates, error_str_or_None) using dnf check-update.
    Exit 100 means updates are available — treat as success, not error.
    """
    try:
        r = subprocess.run(
            ["dnf", "check-update", "--quiet"],
            capture_output=True, text=True, timeout=120,
        )
        rc = r.returncode
    except Exception as exc:
        return [], str(exc)
    if rc not in (0, 100):
        return [], f"dnf check-update exited with code {rc}"

    installed = {}
    try:
        ri = subprocess.run(
            ["dnf", "list", "--installed", "--quiet"],
            capture_output=True, text=True, timeout=60,
        )
        for line in ri.stdout.splitlines():
            parts = line.split()
            if len(parts) >= 2:
                pkg_arch = parts[0]
                pkg_name = pkg_arch.rsplit(".", 1)[0] if "." in pkg_arch else pkg_arch
                installed[pkg_name] = parts[1]
    except Exception:
        pass

    updates = []
    in_obsoleting = False
    for line in r.stdout.splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        if "Obsoleting Packages" in stripped:
            in_obsoleting = True
            continue
        if in_obsoleting:
            continue
        parts = stripped.split()
        if len(parts) < 2:
            continue
        try:
            pkg_arch = parts[0]
            pkg_name = pkg_arch.rsplit(".", 1)[0] if "." in pkg_arch else pkg_arch
            available_version = parts[1]
            current_version = installed.get(pkg_name, "")
            updates.append({
                "package": pkg_name,
                "current_version": current_version,
                "available_version": available_version,
            })
        except Exception:
            continue
    return updates, None


def _ua_parse_zypper():
    """Return (updates, error_str_or_None) using zypper list-updates."""
    try:
        r = subprocess.run(
            ["zypper", "--quiet", "list-updates"],
            capture_output=True, text=True, timeout=60,
        )
        out = r.stdout
    except Exception as exc:
        return [], str(exc)
    updates = []
    for line in out.splitlines():
        if "|" not in line:
            continue
        parts = [p.strip() for p in line.split("|")]
        # Columns: S | Repository | Name | Current Version | Available Version | Arch
        if len(parts) < 6:
            continue
        name = parts[2]
        current_version = parts[3]
        available_version = parts[4]
        if name in ("Name", "S", "") or not available_version:
            continue
        updates.append({
            "package": name,
            "current_version": current_version,
            "available_version": available_version,
        })
    return updates, None


def cmd_update_availability():
    # Detect package manager (mirrors platform-profile detection)
    if shutil.which("apt-get"):
        pm = "apt"
    elif shutil.which("dnf"):
        pm = "dnf"
    elif shutil.which("zypper"):
        pm = "zypper"
    else:
        pm = "unavailable"

    errors = []
    updates = []

    if pm == "apt":
        updates, err = _ua_parse_apt()
        if err:
            errors.append({"code": "apt_error", "message": err})
    elif pm == "dnf":
        updates, err = _ua_parse_dnf()
        if err:
            errors.append({"code": "dnf_error", "message": err})
    elif pm == "zypper":
        updates, err = _ua_parse_zypper()
        if err:
            errors.append({"code": "zypper_error", "message": err})
    else:
        errors.append({
            "code": "pm_unavailable",
            "message": "No supported package manager (apt/dnf/zypper) found",
        })

    result = envelope("update-availability", {"source": pm, "updates": updates})
    if errors:
        result["status"] = "partial" if updates else "error"
        result["errors"] = errors
    return result


# ---------------------------------------------------------------------------
# Firmware update availability (fwupdmgr + apt firmware packages)
# ---------------------------------------------------------------------------

_APT_FW_PATTERNS = (
    "linux-firmware", "firmware-", "nvidia-firmware",
    "-bios", "-uefi", "intel-microcode", "amd64-microcode",
    "nvidia-vbios", "dgx-bios", "amd-ucode",
)


def cmd_firmware_updates():
    all_updates = []
    all_errors = []

    # ── 1. fwupdmgr LVFS updates ──────────────────────────────────────────────
    if shutil.which("fwupdmgr"):
        try:
            r = subprocess.run(
                ["fwupdmgr", "get-updates", "--json"],
                capture_output=True, text=True, timeout=30,
            )
            if r.returncode in (0, 2) and r.stdout.strip():
                data = json.loads(r.stdout)
                for dev in data.get("Devices", []):
                    flags = dev.get("Flags", [])
                    needs_reboot = "require-ac" in flags or "needs-reboot" in flags
                    for rel in dev.get("Releases", []):
                        all_updates.append({
                            "package": dev.get("DeviceId", dev.get("Name", "unknown")),
                            "device_name": dev.get("Name", ""),
                            "current_version": dev.get("Version", ""),
                            "available_version": rel.get("Version", ""),
                            "source": "fwupd",
                            "requires_reboot": needs_reboot,
                            "summary": rel.get("Summary", ""),
                        })
            elif r.returncode not in (0, 2):
                all_errors.append({
                    "code": "fwupd_error",
                    "message": f"fwupdmgr exited {r.returncode}: {r.stderr.strip()[:200]}",
                })
        except subprocess.TimeoutExpired:
            all_errors.append({"code": "fwupd_timeout", "message": "fwupdmgr get-updates timed out"})
        except Exception as exc:
            all_errors.append({"code": "fwupd_exception", "message": str(exc)})

    # ── 2. apt firmware packages ───────────────────────────────────────────────
    if shutil.which("apt"):
        existing = {u["package"] for u in all_updates}
        try:
            r = subprocess.run(
                ["apt", "list", "--upgradable"],
                capture_output=True, text=True, timeout=60,
                env={**os.environ, "LANG": "C", "LC_ALL": "C"},
            )
            for line in r.stdout.splitlines():
                if line.startswith("Listing") or "/" not in line:
                    continue
                try:
                    parts = line.split()
                    pkg = parts[0].split("/")[0]
                except Exception:
                    continue
                if not any(pat in pkg.lower() for pat in _APT_FW_PATTERNS):
                    continue
                if pkg in existing:
                    continue
                avail = parts[1] if len(parts) > 1 else ""
                current = ""
                if "[upgradable from:" in line:
                    current = line.split("[upgradable from:")[-1].rstrip("]").strip()
                all_updates.append({
                    "package": pkg,
                    "device_name": pkg,
                    "current_version": current,
                    "available_version": avail,
                    "source": "apt-firmware",
                    "requires_reboot": True,
                    "summary": f"Firmware package: {pkg}",
                })
                existing.add(pkg)
        except Exception as exc:
            all_errors.append({"code": "apt_firmware_error", "message": str(exc)})

    if any(u["source"] == "fwupd" for u in all_updates):
        src = "fwupd"
    elif all_updates:
        src = "apt-firmware"
    else:
        src = "unavailable"

    result = envelope("firmware-updates", {"source": src, "updates": all_updates})
    if all_errors:
        result["status"] = "partial" if all_updates else "error"
        result["errors"] = all_errors
    return result


